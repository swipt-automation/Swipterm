        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой системе нет ядра, которое может загрузиться на этом устройстве. Используйте архив с ядром ARM64 для страниц размером 4 КБ или 16 КБ."
          }
