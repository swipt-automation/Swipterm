    "The container shuts down while it’s exported and restarts afterward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إيقاف تشغيل الحاوية أثناء تصديرها، ثم يُعاد تشغيلها بعد ذلك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнерът се изключва по време на експортирането и след това се рестартира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করার সময় কন্টেনারটি বন্ধ থাকে এবং পরে আবার চালু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenidor s’atura mentre s’exporta i es torna a iniciar després."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner se během exportu vypne a poté se znovu spustí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Containeren lukkes ned, mens den eksporteres, og starter igen bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Container wird während des Exports heruntergefahren und anschließend neu gestartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κοντέινερ τερματίζεται κατά την εξαγωγή του και επανεκκινείται στη συνέχεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenedor se apaga mientras se exporta y se reinicia después."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenedor se apaga mientras se exporta y se reinicia después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کانتینر هنگام صادر شدن خاموش می‌شود و پس از آن دوباره راه‌اندازی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säiliö sammutetaan viennin ajaksi ja käynnistetään sen jälkeen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conteneur est arrêté pendant son exportation, puis redémarré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conteneur est arrêté pendant son exportation, puis redémarré."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક્સપોર્ટ થતી વખતે કન્ટેનર બંધ થાય છે અને પછી ફરી શરૂ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכולה נכבית בזמן הייצוא ומופעלת מחדש לאחר מכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट होने के दौरान कंटेनर बंद रहता है और उसके बाद रीस्टार्ट होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremnik se isključuje tijekom izvoza i nakon toga ponovno pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konténer az exportálás idejére leáll, majd utána újraindul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontainer dimatikan selama diekspor dan dimulai ulang setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il container viene arrestato durante l’esportazione e riavviato al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し中はコンテナが停止し、完了後に再起動します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер экспортталып жатқанда өшіріледі және кейін қайта іске қосылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಆಗುತ್ತಿರುವಾಗ ಕಂಟೇನರ್ ಶಟ್ ಡೌನ್ ಆಗುತ್ತದೆ ಮತ್ತು ನಂತರ ರೀಸ್ಟಾರ್ಟ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내는 동안 컨테이너가 종료되며 완료 후 다시 시작됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuojant konteineris išjungiamas, o po to paleidžiamas iš naujo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ചെയ്യുമ്പോൾ കണ്ടെയ്‌നർ ഷട്ട് ഡൗൺ ആകുകയും അതിനുശേഷം റീസ്റ്റാർട്ട് ആകുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट होत असताना कंटेनर बंद होतो आणि नंतर पुन्हा सुरू होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekas dimatikan semasa dieksport dan dimulakan semula selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Containeren slås av mens den eksporteres, og startes på nytt etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De container wordt tijdens het exporteren uitgeschakeld en daarna opnieuw gestart."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ୍ସପୋର୍ଟ ହେଉଥିବା ସମୟରେ କଣ୍ଟେନର ବନ୍ଦ ହୁଏ ଏବଂ ପରେ ପୁଣି ଆରମ୍ଭ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਕਸਪੋਰਟ ਹੋਣ ਦੌਰਾਨ ਕੰਟੇਨਰ ਬੰਦ ਹੋ ਜਾਂਦਾ ਹੈ ਅਤੇ ਬਾਅਦ ਵਿੱਚ ਰੀਸਟਾਰਟ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener zostanie wyłączony na czas eksportu, a następnie uruchomiony ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner é desligado durante a exportação e reiniciado em seguida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contentor é desligado durante a exportação e reiniciado em seguida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containerul se oprește în timpul exportului și repornește după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время экспорта контейнер выключается, а затем перезапускается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner sa počas exportu vypne a potom sa znova spustí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik se med izvozom zaustavi in nato znova zažene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containern stängs av medan den exporteras och startas om efteråt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றப்படும்போது கண்டெய்னர் நிறுத்தப்பட்டு, அதன் பிறகு மீண்டும் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్స్‌పోర్ట్ అవుతున్నప్పుడు కంటైనర్ షట్ డౌన్ అవుతుంది, ఆ తర్వాత రీస్టార్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอนเทนเนอร์จะปิดลงขณะส่งออกและเริ่มการทำงานใหม่หลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsayıcı, dışa aktarılırken kapanır ve ardından yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час експортування контейнер вимикається, а потім перезапускається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "برآمد ہونے کے دوران کنٹینر بند رہتا ہے اور اس کے بعد ری اسٹارٹ ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng chứa sẽ tắt trong khi được xuất và khởi động lại sau đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出期間容器會關閉，並於完成後重新啟動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出期间容器将关闭，完成后重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出期間容器會關閉，並於完成後重新啟動。"
          }
        }
      }
    },
    "The password can’t contain line breaks or control characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي كلمة السر على فواصل أسطر أو أحرف تحكم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата не може да съдържа нови редове или контролни символи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডে লাইন ব্রেক বা কন্ট্রোল ক্যারেক্টার থাকতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La contrasenya no pot contenir salts de línia ni caràcters de control."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo nesmí obsahovat zalomení řádků ani řídicí znaky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden må ikke indeholde linjeskift eller kontroltegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό δεν μπορεί να περιέχει αλλαγές γραμμής ή χαρακτήρες ελέγχου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña no puede contener saltos de línea ni caracteres de control."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña no puede contener saltos de línea ni caracteres de control."
          }
        },
