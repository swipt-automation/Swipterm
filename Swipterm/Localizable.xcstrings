    "The password can’t contain line breaks or control characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي كلمة السر على فواصل أسطر أو أحرف تحكم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата не може да съдържа нови редове или контролни символи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডে লাইন ব্রেক বা কন্ট্রোল ক্যারেক্টার থাকতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La contrasenya no pot contenir salts de línia ni caràcters de control."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo nesmí obsahovat zalomení řádků ani řídicí znaky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden må ikke indeholde linjeskift eller kontroltegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό δεν μπορεί να περιέχει αλλαγές γραμμής ή χαρακτήρες ελέγχου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña no puede contener saltos de línea ni caracteres de control."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña no puede contener saltos de línea ni caracteres de control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز عبور نمی‌تواند شامل خط جدید یا نویسه‌های کنترلی باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana ei voi sisältää rivinvaihtoja tai ohjausmerkkejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe ne peut pas contenir de sauts de ligne ni de caractères de contrôle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe ne peut pas contenir de sauts de ligne ni de caractères de contrôle."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાસવર્ડમાં લાઇન બ્રેક કે કંટ્રોલ કૅરેક્ટર હોઈ શકતા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה לא יכולה להכיל מעברי שורה או תווי בקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड में लाइन ब्रेक या कंट्रोल कैरेक्टर नहीं हो सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka ne smije sadržavati prijelome retka ni kontrolne znakove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó nem tartalmazhat sortörést vagy vezérlőkaraktert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi tidak boleh berisi baris baru atau karakter kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password non può contenere interruzioni di riga o caratteri di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードに改行や制御文字は使用できません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құпиясөзде жол үзілімдері немесе басқару таңбалары болмауы керек."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಾಸ್‌ವರ್ಡ್‌ನಲ್ಲಿ ಲೈನ್ ಬ್ರೇಕ್‌ಗಳು ಅಥವಾ ಕಂಟ್ರೋಲ್ ಅಕ್ಷರಗಳು ಇರುವಂತಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호에는 줄 바꿈이나 제어 문자를 포함할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodyje negali būti eilučių lūžių ar valdymo simbolių."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌വേഡിൽ ലൈൻ ബ്രേക്കുകളോ കൺട്രോൾ പ്രതീകങ്ങളോ പാടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्डमध्ये लाइन ब्रेक किंवा कंट्रोल कॅरेक्टर असू शकत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
