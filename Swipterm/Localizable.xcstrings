    "Exporting takes a long time. The container shuts down during the export and restarts afterward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق التصدير وقتًا طويلاً. يتم إيقاف تشغيل الحاوية أثناء التصدير، ثم يُعاد تشغيلها بعد ذلك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортирането отнема много време. Контейнерът се изключва по време на експортирането и след това се рестартира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করতে অনেক সময় লাগে। এক্সপোর্ট চলাকালীন কন্টেনারটি বন্ধ থাকে এবং পরে আবার চালু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exportació triga molt de temps. El contenidor s’atura durant l’exportació i es torna a iniciar després."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Export trvá dlouho. Kontejner se během exportu vypne a poté se znovu spustí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport tager lang tid. Containeren lukkes ned under eksporten og starter igen bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export dauert lange. Der Container wird während des Exports heruntergefahren und anschließend neu gestartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξαγωγή διαρκεί πολύ. Το κοντέινερ τερματίζεται κατά την εξαγωγή και επανεκκινείται στη συνέχεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación tarda mucho tiempo. El contenedor se apaga durante la exportación y se reinicia después."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación tarda mucho tiempo. El contenedor se apaga durante la exportación y se reinicia después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صادر کردن زمان زیادی طول می‌کشد. کانتینر در طول صادر کردن خاموش می‌شود و پس از آن دوباره راه‌اندازی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienti kestää kauan. Säiliö sammutetaan viennin ajaksi ja käynnistetään sen jälkeen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exportation prend beaucoup de temps. Le conteneur est arrêté pendant l’exportation, puis redémarré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exportation prend beaucoup de temps. Le conteneur est arrêté pendant l’exportation, puis redémarré."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક્સપોર્ટ કરવામાં ઘણો સમય લાગે છે. એક્સપોર્ટ દરમિયાન કન્ટેનર બંધ થાય છે અને પછી ફરી શરૂ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא נמשך זמן רב. המכולה נכבית במהלך הייצוא ומופעלת מחדש לאחר מכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट करने में काफ़ी समय लगता है। एक्सपोर्ट के दौरान कंटेनर बंद रहता है और उसके बाद रीस्टार्ट होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvoz traje dugo. Spremnik se isključuje tijekom izvoza i nakon toga ponovno pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az exportálás sokáig tart. A konténer az exportálás idejére leáll, majd utána újraindul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor memerlukan waktu lama. Kontainer dimatikan selama ekspor dan dimulai ulang setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esportazione richiede molto tempo. Il container viene arrestato durante l’esportazione e riavviato al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しには時間がかかります。書き出し中はコンテナが停止し、完了後に再起動します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорттау ұзақ уақыт алады. Экспорттау кезінде контейнер өшіріледі және кейін қайта іске қосылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಮಾಡಲು ಹೆಚ್ಚು ಸಮಯ ಬೇಕಾಗುತ್ತದೆ. ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಸಮಯದಲ್ಲಿ ಕಂಟೇನರ್ ಶಟ್ ಡೌನ್ ಆಗುತ್ತದೆ ಮತ್ತು ನಂತರ ರೀಸ್ಟಾರ್ಟ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기에는 시간이 오래 걸립니다. 내보내는 동안 컨테이너가 종료되며 완료 후 다시 시작됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportavimas trunka ilgai. Eksportuojant konteineris išjungiamas, o po to paleidžiamas iš naujo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ചെയ്യാൻ കൂടുതൽ സമയമെടുക്കും. എക്സ്പോർട്ട് ചെയ്യുമ്പോൾ കണ്ടെയ്‌നർ ഷട്ട് ഡൗൺ ആകുകയും അതിനുശേഷം റീസ്റ്റാർട്ട് ആകുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट करण्यास बराच वेळ लागतो. एक्सपोर्टदरम्यान कंटेनर बंद होतो आणि नंतर पुन्हा सुरू होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeksportan mengambil masa yang lama. Bekas dimatikan semasa pengeksportan dan dimulakan semula selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport tar lang tid. Containeren slås av under eksporten og startes på nytt etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteren duurt lang. De container wordt tijdens het exporteren uitgeschakeld en daarna opnieuw gestart."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ୍ସପୋର୍ଟ କରିବାକୁ ଅଧିକ ସମୟ ଲାଗେ। ଏକ୍ସପୋର୍ଟ ସମୟରେ କଣ୍ଟେନର ବନ୍ଦ ହୁଏ ଏବଂ ପରେ ପୁଣି ଆରମ୍ଭ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਕਸਪੋਰਟ ਕਰਨ ਵਿੱਚ ਕਾਫ਼ੀ ਸਮਾਂ ਲੱਗਦਾ ਹੈ। ਐਕਸਪੋਰਟ ਦੌਰਾਨ ਕੰਟੇਨਰ ਬੰਦ ਹੋ ਜਾਂਦਾ ਹੈ ਅਤੇ ਬਾਅਦ ਵਿੱਚ ਰੀਸਟਾਰਟ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport trwa długo. Kontener zostanie wyłączony na czas eksportu, a następnie uruchomiony ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação demora bastante. O contêiner é desligado durante a exportação e reiniciado em seguida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação demora bastante tempo. O contentor é desligado durante a exportação e reiniciado em seguida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportul durează mult. Containerul se oprește în timpul exportului și repornește după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт занимает много времени. Во время экспорта контейнер выключается, а затем перезапускается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Export trvá dlho. Kontajner sa počas exportu vypne a potom sa znova spustí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvoz traja dolgo. Vsebnik se med izvozom zaustavi in nato znova zažene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporten tar lång tid. Containern stängs av under exporten och startas om efteråt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி செய்ய நீண்ட நேரம் ஆகும். ஏற்றுமதியின்போது கண்டெய்னர் நிறுத்தப்பட்டு, அதன் பிறகு மீண்டும் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్స్‌పోర్ట్ చేయడానికి చాలా సమయం పడుతుంది. ఎక్స్‌పోర్ట్ సమయంలో కంటైనర్ షట్ డౌన్ అవుతుంది, ఆ తర్వాత రీస్టార్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งออกใช้เวลานาน คอนเทนเนอร์จะปิดลงระหว่างการส่งออกและเริ่มการทำงานใหม่หลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma uzun sürer. Kapsayıcı, dışa aktarma sırasında kapanır ve ardından yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортування триває довго. Під час експортування контейнер вимикається, а потім перезапускається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "برآمد کرنے میں کافی وقت لگتا ہے۔ برآمد کے دوران کنٹینر بند رہتا ہے اور اس کے بعد ری اسٹارٹ ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình xuất mất nhiều thời gian. Vùng chứa sẽ tắt trong khi xuất và khởi động lại sau đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出需時較長。匯出期間容器會關閉，並於完成後重新啟動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出需要较长时间。导出期间容器将关闭，完成后重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出需要較長時間。輸出期間容器會關閉，並於完成後重新啟動。"
          }
        }
      }
    },
