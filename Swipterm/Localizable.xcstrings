          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hylkäsi luodut määritykset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a rejeté la configuration générée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a rejeté la configuration générée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જનરેટ કરેલું કૉન્ફિગરેશન %@ દ્વારા નકારવામાં આવ્યું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ דחה את התצורה שנוצרה."
          }
        },
