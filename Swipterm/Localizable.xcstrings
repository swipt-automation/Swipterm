        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортирането отнема много време."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করতে অনেক সময় লাগে।"
