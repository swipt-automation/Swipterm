    "The distribution is not recognized; skipping the selected software.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التعرف على التوزيعة؛ سيتم تخطي البرامج المحددة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибуцията не е разпозната; избраният софтуер се пропуска."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিস্ট্রিবিউশনটি শনাক্ত করা যায়নি; বেছে নেওয়া সফটওয়্যার এড়িয়ে যাওয়া হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha reconegut la distribució; s’omet el programari seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuce nebyla rozpoznána; vybraný software se přeskočí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributionen blev ikke genkendt; den valgte software springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Distribution wurde nicht erkannt; die ausgewählte Software wird übersprungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διανομή δεν αναγνωρίστηκε. Το επιλεγμένο λογισμικό παραλείπεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha reconocido la distribución; se omite el software seleccionado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció la distribución; se omite el software seleccionado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توزیع شناسایی نشد؛ نرم‌افزارهای انتخاب‌شده نادیده گرفته می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakelua ei tunnistettu. Valittu ohjelmisto ohitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribution non reconnue ; les logiciels sélectionnés sont ignorés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribution non reconnue. Les logiciels sélectionnés sont ignorés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિસ્ટ્રિબ્યુશન ઓળખી શકાયું નહીં; પસંદ કરેલું સૉફ્ટવેર છોડી દેવામાં આવી રહ્યું છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההפצה לא זוהתה; התוכנה שנבחרה תדולג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्ट्रिब्यूशन की पहचान नहीं हो सकी; चुना गया सॉफ़्टवेयर छोड़ा जा रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribucija nije prepoznata; odabrani softver se preskače."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A disztribúció nem ismerhető fel; a kiválasztott szoftverek kimaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribusi tidak dikenali; melewati perangkat lunak yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuzione non riconosciuta; il software selezionato viene ignorato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディストリビューションを認識できません。選択したソフトウェアはスキップします。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибутив анықталмады; таңдалған бағдарламалық жасақтама өткізіп жіберіледі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡಿಸ್ಟ್ರಿಬ್ಯೂಷನ್ ಅನ್ನು ಗುರುತಿಸಲಾಗಿಲ್ಲ; ಆಯ್ಕೆಮಾಡಿದ ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಸ್ಕಿಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배포판을 인식할 수 없습니다. 선택한 소프트웨어를 건너뜁니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribucija neatpažinta; pasirinkta programinė įranga praleidžiama."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡിസ്ട്രിബ്യൂഷൻ തിരിച്ചറിഞ്ഞില്ല; തിരഞ്ഞെടുത്ത സോഫ്റ്റ്‌വെയർ ഒഴിവാക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्ट्रिब्युशन ओळखता आले नाही; निवडलेले सॉफ्टवेअर वगळत आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengedaran tidak dikenali; melangkau perisian yang dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribusjonen ble ikke gjenkjent; den valgte programvaren hoppes over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De distributie is niet herkend. De geselecteerde software wordt overgeslagen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡିଷ୍ଟ୍ରିବ୍ୟୁସନ୍ ଚିହ୍ନଟ ହୋଇପାରିଲା ନାହିଁ; ଚୟନ କରାଯାଇଥିବା ସଫ୍ଟୱେର୍ ଛାଡ଼ି ଦିଆଯାଉଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਸਟ੍ਰੀਬਿਊਸ਼ਨ ਦੀ ਪਛਾਣ ਨਹੀਂ ਹੋਈ; ਚੁਣਿਆ ਗਿਆ ਸਾਫ਼ਟਵੇਅਰ ਛੱਡਿਆ ਜਾ ਰਿਹਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie rozpoznano dystrybucji; wybrane oprogramowanie jest pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distribuição não foi reconhecida; o software selecionado será ignorado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A distribuição não foi reconhecida; o software selecionado será ignorado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuția nu este recunoscută; software-ul selectat este omis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибутив не распознан; выбранное программное обеспечение пропускается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribúcia nebola rozpoznaná; vybraný softvér sa preskočí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribucija ni prepoznana; izbrana programska oprema se preskoči."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributionen kändes inte igen; den valda programvaran hoppas över."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விநியோகத்தை அடையாளம் காண முடியவில்லை. தேர்ந்தெடுத்த மென்பொருள் தவிர்க்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిస్ట్రిబ్యూషన్ గుర్తించబడలేదు; ఎంచుకున్న సాఫ్ట్‌వేర్‌ను స్కిప్ చేస్తోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รู้จักดิสทริบิวชั่นนี้ จะข้ามซอฟต์แวร์ที่เลือกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağıtım tanınmadı; seçilen yazılım atlanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дистрибутив не розпізнано; вибране програмне забезпечення пропускається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈسٹری بیوشن کی شناخت نہیں ہو سکی؛ منتخب کردہ سافٹ ویئر کو چھوڑا جا رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhận dạng được bản phân phối; bỏ qua phần mềm đã chọn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別發行版；將略過所選軟件。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别发行版；将跳过所选软件。"
          }
        },
