        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tekst indeholder linjeskift og kan køre kommandoer, så snart den indsættes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text enthält Zeilenumbrüche und kann beim Einsetzen sofort Befehle ausführen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το κείμενο περιέχει αλλαγές γραμμής και ενδέχεται να εκτελέσει εντολές αμέσως μόλις επικολληθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto contiene saltos de línea y podría ejecutar comandos en cuanto se pegue."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto contiene saltos de línea y podría ejecutar comandos en cuanto se pegue."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این متن دارای شکست خط است و ممکن است بلافاصله پس از چسباندن، فرمان‌هایی را اجرا کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä teksti sisältää rivinvaihtoja ja voi suorittaa komentoja heti, kun se sijoitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte contient des sauts de ligne et pourrait exécuter des commandes dès qu’il sera collé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte contient des sauts de ligne et pourrait exécuter des commandes dès qu’il sera collé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ટેક્સ્ટમાં લાઇન બ્રેક છે અને પેસ્ટ થતાં જ તે કમાન્ડ ચલાવી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט זה מכיל מעברי שורה ועלול להריץ פקודות מיד עם הדבקתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टेक्स्ट में लाइन ब्रेक हैं और पेस्ट करते ही यह कमांड चला सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj tekst sadrži prijelome redaka i može pokrenuti naredbe čim se zalijepi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szöveg sortöréseket tartalmaz, és a beillesztés pillanatában parancsokat futtathat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks ini berisi jeda baris dan dapat menjalankan perintah segera setelah ditempel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo testo contiene interruzioni di riga e potrebbe eseguire comandi non appena viene incollato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストには改行が含まれているため、ペーストした時点でコマンドが実行される可能性があります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл мәтінде жол үзілімдері бар және қойылған бойда пәрмендерді іске қосуы мүмкін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪಠ್ಯದಲ್ಲಿ ಲೈನ್ ಬ್ರೇಕ್‌ಗಳಿವೆ ಮತ್ತು ಪೇಸ್ಟ್ ಮಾಡಿದ ತಕ್ಷಣ ಕಮಾಂಡ್‌ಗಳನ್ನು ರನ್ ಮಾಡಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 텍스트에는 줄 바꿈이 포함되어 있어 붙여넣는 즉시 명령이 실행될 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame tekste yra eilučių lūžių, todėl jį įklijavus iškart gali būti vykdomos komandos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ടെക്സ്റ്റിൽ ലൈൻ ബ്രേക്കുകൾ ഉള്ളതിനാൽ പേസ്റ്റ് ചെയ്യുമ്പോൾത്തന്നെ കമാൻഡുകൾ റൺ ചെയ്തേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मजकुरात लाइन ब्रेक आहेत आणि पेस्ट करताच तो कमांड चालवू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks ini mengandungi pemisah baris dan mungkin menjalankan perintah sebaik sahaja ditampal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne teksten inneholder linjeskift og kan kjøre kommandoer så snart den limes inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tekst bevat regeleinden en kan opdrachten uitvoeren zodra hij wordt geplakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଟେକ୍ସଟରେ ଲାଇନ୍ ବ୍ରେକ୍ ଅଛି ଏବଂ ପେଷ୍ଟ କରିବା ମାତ୍ରେ ଏହା କମାଣ୍ଡ ଚଲାଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਟੈਕਸਟ ਵਿੱਚ ਲਾਈਨ ਬ੍ਰੇਕ ਹਨ ਅਤੇ ਪੇਸਟ ਕਰਦੇ ਹੀ ਇਹ ਕਮਾਂਡਾਂ ਚਲਾ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tekst zawiera podziały wierszy i może uruchomić polecenia od razu po wklejeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
